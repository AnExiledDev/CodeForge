{
  "description": "Agent redirection and team orchestration hooks",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PLUGIN_ROOT}/scripts/redirect-builtin-agents.py",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
