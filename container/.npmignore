# Files to exclude from npm package

# Development and testing
test.js
.devcontainer/state/
.devcontainer/.generated/
.devcontainer/config/backups/

# Documentation that's not needed in package
docs/

# Git and development
.git/
.github/
.gitignore

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~

# OS specific
.DS_Store
Thumbs.db

# Temporary files
*.tmp
*.temp

# Logs
*.log

# Environment files (never publish)
.env
.env.*
.devcontainer/.env
.devcontainer/.env.*

# User config artifacts (generated during --force update)
.devcontainer/**/*.codeforge-new
.devcontainer/**/*.bak
.devcontainer/.codeforge-preserve

# Python bytecode
**/__pycache__/
*.pyc

# Secrets (never publish)
.secrets
.devcontainer/.secrets

# Per-installation state (not tracked)
.codeforge/.checksums/
.codeforge/.markers/
.codeforge/data/
